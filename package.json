{
  "name": "@yikuaibanz1/dsh-voice-bubble",
  "version": "0.1.2",
  "type": "module",
  "description": "WeChat-style voice messages for DeepSeek Harness chat: send_voice TTS tool + inline audio player with duration and transcript. 语音气泡 / 语音消息 / 文字转语音 / 发语音 for DSH.",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "author": "YIKUAIBANZI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YIKUAIBANZI/dsh-voice-bubble.git"
  },
  "homepage": "https://github.com/YIKUAIBANZI/dsh-voice-bubble",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "voice",
    "voice-message",
    "voice-bubble",
    "tts",
    "text-to-speech",
    "speech",
    "speech-synthesis",
    "audio",
    "audio-player",
    "chat-ui",
    "wechat",
    "accessibility",
    "语音",
    "语音消息",
    "语音气泡",
    "文字转语音"
  ]
}