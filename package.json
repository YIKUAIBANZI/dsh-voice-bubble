{
  "name": "@yikuaibanz1/dsh-voice-bubble",
  "version": "0.1.1",
  "type": "module",
  "description": "Voice messages in the DSH chat: a send_voice tool plus a WeChat-style bubble with play, duration, and 转文字.",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "author": "YIKUAIBANZI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YIKUAIBANZI/dsh-voice-bubble.git"
  },
  "homepage": "https://github.com/YIKUAIBANZI/dsh-voice-bubble",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "voice",
    "tts",
    "audio",
    "chat-ui"
  ]
}